# Copy to .env for local runs. Never commit the real file.
SECRET_KEY=change-me-to-a-long-random-string

# Local: SQLite. Supabase: Project settings → Database → Connection string (URI).
DATABASE_URL=sqlite:///jerd-dev.db
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Firebase console → Project settings → Service accounts → Generate new private key.
FIREBASE_CREDENTIALS=
# Google AI Studio → Get API key.
GEMINI_API_KEY=
# Optional; overload retries fall back to other Flash models.
# GEMINI_MODEL=gemini-3.6-flash
SENTRY_DSN=
# Secret the scheduler sends to POST /jobs/nightly-digest.
CRON_SECRET=

LATEST_VERSION=0.1.0
LATEST_BUILD=1
MIN_BUILD=1
APK_URL=
RELEASE_NOTES=
